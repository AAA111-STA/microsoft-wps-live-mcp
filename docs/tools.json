    {
      "name": "office_api_batch",
      "description": "Compose ANY public native Office/WPS object-model operations, beyond the convenience tools.\n\n        Each step: action=get/set/call, target (default document), member, optional args array,\n        kwargs object, value for set, as alias. Example: call document.Slides.Add(1,12) with\n        {\"action\":\"call\",\"target\":\"document.Slides\",\"member\":\"Add\",\"args\":[1,12],\"as\":\"slide\"}.\n        Then target=\"slide.Shapes\", member=\"AddShape\", args=[1,40,40,200,80], as=\"box\";\n        set target=\"box.TextFrame.TextRange\", member=\"Text\", value=\"Data processing\".\n        Arguments can reference previous aliases or returned object IDs using {\"$ref\":\"box\"}.\n        Output COM objects become object_id references usable across calls in this document.\n        Indexed-property calls (Item, Range, etc.) can set read_only=true when genuinely read-only.\n        Batches stop at the first error, keep earlier live edits, and return partial_error with completed results.\n        Successful modifying batches automatically save, including existing user edits.\n        Any installed native component is addressable; unsupported members fail explicitly.\n        Uses native COM, not Python eval/exec. This grants the same desktop access as the native API.\n        ",
      "inputSchema": {
        "properties": {
          "document": {
            "title": "Document",
            "type": "string"
          },
          "steps": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "document",
          "steps"
        ],
        "type": "object",
        "title": "office_api_batchArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
