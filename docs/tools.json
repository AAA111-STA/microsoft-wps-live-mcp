    {
      "name": "office_live_steps",
      "description": "Build or edit ANY Office task in named visible stages, saving each stage as the user watches.\n\n        stages=[{label:'Create title',steps:[...native get/set/call steps...],focus:{slide:1}}, ...].\n        Steps use office_api_batch syntax. Aliases carry across stages within this call.\n        Focus can address Word start/end offsets, Excel sheet/address, or PPT slide/shape.\n        pause_ms is 0..2000 ms between stages, default 450. Keep stages short and meaningful.\n        Emits standard MCP progress where supported. Stages are not transactions; stop on partial_error/display_error.\n        For long calls returning pending, query office_operation_status and do not replay the workflow.\n        ",
      "inputSchema": {
        "properties": {
          "document": {
            "title": "Document",
            "type": "string"
          },
          "stages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Stages",
            "type": "array"
          },
          "pause_ms": {
            "default": 450,
            "title": "Pause Ms",
            "type": "integer"
          }
        },
        "required": [
          "document",
          "stages"
        ],
        "type": "object",
        "title": "office_live_stepsArguments"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      }
    },
